# Admin panel environment variables.
# Copy the NAMES into Vercel → Project → Settings → Environment Variables.
# Do NOT put real values in this file or commit them — this is documentation only.

# Login email (identifier)
ADMIN_EMAIL=you@example.com

# One-way password hash "salt:scryptHex" — generate with:
#   node scripts/hash-password.mjs 'your-password'
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies (the generator prints one)
SESSION_SECRET=

# Vercel KV / Upstash Redis — injected automatically when you connect a KV store
# in the Vercel dashboard. Listed here only so you know what the code expects.
KV_REST_API_URL=
KV_REST_API_TOKEN=
